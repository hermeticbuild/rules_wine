load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("//wine/private:payload.bzl", "payload_platform")

package(default_visibility = ["//wine:__subpackages__"])

exports_files(glob(["*.bzl"]))

payload_platform(name = "payload_platform")

bzl_library(
    name = "adapter",
    srcs = ["adapter.bzl"],
    # keep: the Starlark plugin guesses lib; upstream exports lib_bzl instead.
    deps = [
        "paths",
        "payload",
        "@hermetic_launcher//launcher:lib_bzl",
    ],
)

bzl_library(
    name = "registrations",
    srcs = ["registrations.bzl"],
    deps = ["//wine:toolchain"],
)

bzl_library(
    name = "tools_registrations",
    srcs = ["tools_registrations.bzl"],
    deps = ["//wine:tools_toolchain"],
)

bzl_library(
    name = "tool_binary",
    srcs = ["tool_binary.bzl"],
    # keep: the Starlark plugin guesses lib; upstream exports lib_bzl instead.
    deps = ["@hermetic_launcher//launcher:lib_bzl"],
)

bzl_library(
    name = "paths",
    srcs = ["paths.bzl"],
)

bzl_library(
    name = "payload",
    srcs = ["payload.bzl"],
)

bzl_library(
    name = "repositories",
    srcs = ["repositories.bzl"],
)

bzl_library(
    name = "tools_repositories",
    srcs = ["tools_repositories.bzl"],
)
