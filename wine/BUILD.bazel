load("@bazel_lib//:bzl_library.bzl", "bzl_library")
load("//wine/private:tool_binary.bzl", "wine_tool_binary")

# gazelle:map_kind bzl_library bzl_library @bazel_lib//:bzl_library.bzl

package(default_visibility = ["//visibility:public"])

toolchain_type(name = "runner_toolchain_type")

toolchain_type(name = "tools_toolchain_type")

toolchain_type(name = "tools_executable_toolchain_type")

wine_tool_binary(
    name = "wmc",
    tool = "wmc",
)

wine_tool_binary(
    name = "wrc",
    tool = "wrc",
)

wine_tool_binary(
    name = "widl",
    tool = "widl",
)

exports_files([
    "actions.bzl",
    "toolchain.bzl",
    "tools_toolchain.bzl",
    "wine_idl_files.bzl",
    "wine_message_file.bzl",
    "wine_resource_file.bzl",
    "windows_binary.bzl",
])

# Adapter outputs must run on their configured target (host, or consuming exec).
toolchain_type(name = "adapter_toolchain_type")

bzl_library(
    name = "windows_binary",
    srcs = ["windows_binary.bzl"],
    deps = [
        "//wine/private:adapter",
        "//wine/private:payload",
    ],
)

bzl_library(
    name = "actions",
    srcs = ["actions.bzl"],
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
)

bzl_library(
    name = "tools_toolchain",
    srcs = ["tools_toolchain.bzl"],
)

bzl_library(
    name = "wine_idl_files",
    srcs = ["wine_idl_files.bzl"],
)

bzl_library(
    name = "wine_message_file",
    srcs = ["wine_message_file.bzl"],
)

bzl_library(
    name = "wine_resource_file",
    srcs = ["wine_resource_file.bzl"],
)
