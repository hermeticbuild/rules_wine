mapping_variant(
    name = "mapping_variant",
    build_setting_default = "default",
)

mapping_input(name = "mapping_input")

mapping_payload(
    name = "mapping_payload",
    binary = "fixture/fixture_x86_64.exe",
)

mapping_action(
