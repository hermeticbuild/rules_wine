load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//tests:adapter_action.bzl", "adapter_action", "runfiles_action", "runfiles_adapter_action")
load("//tests:argv.bzl", "alias_data", "argv_record_test", "custom_tools_record_test", "mapping_record_test", "two_actions")
load("//tests:native_tools_action.bzl", "native_tools_runfiles")
load("//tests:param_action.bzl", "param_action")
load("//tests:path_mapping.bzl", "mapping_action", "mapping_input", "mapping_payload", "mapping_variant")
load("//tests:tools_action.bzl", "default_tools_action", "tools_action")
load("//tests:verify_test.bzl", "runtime_contract_test")
load("//tests:windows_build_test.bzl", "windows_build_test")
load("//wine:tools_toolchain.bzl", "wine_tools_executable_toolchain", "wine_tools_toolchain")
load("//wine:windows_binary.bzl", "windows_binary")
load("//wine:wine_idl_files.bzl", "wine_idl_files")

wine_idl_files(
    name = "rpc",
    src = "fixture/rpc.idl",
    client = "rpc_c.c",
    header = "tool_rpc.h",
    server = "rpc_s.c",
    tags = ["manual"],
)

cc_library(
    name = "generated_rpc",
    testonly = True,
    srcs = [
        "rpc_c.c",
        "rpc_s.c",
    ],
    hdrs = ["tool_rpc.h"],
    # MinGW rpc.h omits ARM64 from its __RPC_WIN64__ definition.
    defines = select({
        "@platforms//cpu:aarch64": ["__RPC_WIN64__"],
        "//conditions:default": [],
    }),
    tags = ["manual"],
)

[
    windows_build_test(
        name = "rpc_" + cpu + "_test",
        library = "generated_rpc",
        platform = "@llvm//platforms:windows_" + cpu,
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]

cc_binary(
    name = "companion_build",
    testonly = True,
    srcs = ["fixture/companion.c"],
    linkopts = ["-Wl,--no-insert-timestamp"],
    linkshared = True,
    target_compatible_with = ["@platforms//os:windows"],
)

cc_binary(
    name = "fixture_build",
    testonly = True,
    srcs = ["fixture/main.cc"],
    copts = [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkopts = ["-lshell32"],
    target_compatible_with = ["@platforms//os:windows"],
)

cc_binary(
    name = "verify_build",
    testonly = True,
    srcs = ["verify/main.cc"],
    copts = [
        "-std=c++17",
        "-Wall",
        "-Wextra",
    ],
    deps = ["@nlohmann_json//:json"],
)

test_suite(
    name = "integration",
    tests = [
        "argv_test",
        "payload_layout_test",
        "runtime_contract_test",
    ],
)

cc_binary(
    name = "argv_verify",
    testonly = True,
    srcs = ["argv_verify.cc"],
    copts = [
        "-std=c++17",
        "-Wall",
        "-Wextra",
    ],
    deps = ["@nlohmann_json//:json"],
)

cc_binary(
    name = "runfiles_fixture",
    srcs = ["runfiles_fixture.cc"],
    copts = [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    data = [
        "aliases",
        "@rules_cc//:LICENSE",
    ],
    deps = ["@rules_cc//cc/runfiles"],
)

runfiles_action(
    name = "standard_runfiles",
    testonly = True,
    tool = "runfiles_fixture",
)

# Fake compiler: its only job is reading ordinary and alias runfiles.
wine_tools_toolchain(
    name = "native_runfiles_tools",
    testonly = True,
    include = "data/alias-only.txt",
    aarch64_typelib = "data/unused.tlb",
    files = "aliases",
    widl = "runfiles_fixture",
    wmc = "runfiles_fixture",
    wrc = "runfiles_fixture",
    x86_64_typelib = "data/unused.tlb",
)

native_tools_runfiles(
    name = "native_compiler_runfiles",
    testonly = True,
    implementation = "native_runfiles_tools",
)

genrule(
    name = "makevar_runfiles",
    testonly = True,
    outs = ["makevar_runfiles.json"],
    cmd = '"$(WINE_WRC)" "$@"',
    toolchains = ["native_runfiles_tools"],
    tools = ["runfiles_fixture"],
)

wine_tools_executable_toolchain(
    name = "native_executable_runfiles_tools",
    include = "data/alias-only.txt",
    aarch64_typelib = "data/unused.tlb",
    files = "aliases",
    widl = "runfiles_fixture",
    wmc = "runfiles_fixture",
    wrc = "runfiles_fixture",
    x86_64_typelib = "data/unused.tlb",
)

toolchain(
    name = "native_executable_runfiles_registration",
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = "native_executable_runfiles_tools",
    toolchain_type = "//wine:tools_executable_toolchain_type",
)

run_binary(
    name = "tool_binary_runfiles",
    testonly = True,
    outs = ["tool_binary_runfiles.json"],
    args = ["$(location tool_binary_runfiles.json)"],
    tags = ["manual"],
    tool = "//wine:wrc",
)

custom_tools_record_test(
    name = "tool_binary_runfiles_test",
    records = {"tool_binary_runfiles": json.encode([
        "mapped external",
        "alias-only data",
    ])},
)

windows_binary(
    name = "runfiles_binary",
    testonly = True,
    binary = "runfiles_fixture",
    target_platform = "@llvm//platforms:windows_x86_64",
)

runfiles_adapter_action(
    name = "adapter_runfiles",
    testonly = True,
    tool = "runfiles_binary",
)

default_tools_action(
    name = "generate",
    binary = "fixture/fixture_x86_64.exe",
)

alias_data(
    name = "aliases",
    src = "data/alias-only.txt",
)

two_actions(
    name = "distinct_actions",
    binary = "fixture/fixture_x86_64.exe",
)

argv_record_test(
    name = "argv_test",
    records = {
        "default_group_tools": json.encode(["runfile with spaces and Unicode: café"]),
        "makevar_runfiles": json.encode([
            "mapped external",
            "alias-only data",
        ]),
        "native_compiler_runfiles": json.encode([
            "mapped external",
            "alias-only data",
        ]),
        "adapter_runfiles": json.encode([
            "mapped external",
            "alias-only data",
        ]),
        "standard_runfiles": json.encode([
            "mapped external",
            "alias-only data",
        ]),
        "adapter_tool": json.encode([
            "--config",
            "payload-config.json",
            "--",
            "literal",
            "space value",
            "",
            "café",
            "$literal",
            "$(location data/a)",
            "opaque/option:one/two",
            "adapter-tool",
        ]),
    },
)

windows_binary(
    name = "binary",
    binary = "fixture/fixture_x86_64.exe",
    target_compatible_with = ["@platforms//cpu:x86_64"],
)

adapter_action(
    name = "adapter_tool",
    arguments = [
        "--config",
        "payload-config.json",
        "--",
        "literal",
        "space value",
        "",
        "café",
        "$literal",
        "$(location data/a)",
        "opaque/option:one/two",
    ],
    tool = "binary",
)

runtime_contract_test(
    name = "runtime_contract_test",
    size = "medium",
    timeout = "moderate",
    payload = "fixture/fixture_x86_64.exe",
)

exports_files(
    [
        "runtime_consumer.bzl",
        "verify_runtime.sh",
        "fixture/rpc.idl",
        "fixture/fixture_x86_64.exe",
        "fixture/fixture_aarch64.exe",
    ],
    visibility = ["//visibility:public"],
)

param_action(
    name = "param_file",
    binary = "fixture/fixture_x86_64.exe",
)

tools_action(
    name = "external_tools",
    testonly = True,
    additional_tools = True,
    binary = "fixture/fixture_x86_64.exe",
    extra = "runfiles_binary",
    extra_data = "@platforms//:LICENSE",
)

default_tools_action(
    name = "default_group_tools",
    testonly = True,
    additional_tools = True,
    binary = "fixture/fixture_x86_64.exe",
    extra = "runfiles_binary",
)

runtime_contract_test(
    name = "payload_layout_test",
    timeout = "moderate",
    companion = "fixture/companion.dll",
    payload = "fixture/fixture_x86_64.exe",
    payload_layout = True,
)

mapping_variant(
    name = "mapping_variant",
    build_setting_default = "default",
)

mapping_input(name = "mapping_input")

mapping_payload(
    name = "mapping_payload",
    binary = "fixture/fixture_x86_64.exe",
)

mapping_action(
    name = "mapped_paths",
    src = "mapping_input",
    binary = "mapping_payload",
)

mapping_action(
    name = "mapping_collision",
    src = "mapping_input",
    binary = "mapping_payload",
    collision = True,
)

config_setting(
    name = "mapped_output_paths",
    values = {"experimental_output_paths": "strip"},
)

mapping_record_test(
    name = "mapping_test",
    collision = "mapping_collision",
    distinct = "distinct_actions",
    mapped = "mapped_paths",
    mapped_paths = select({
        ":mapped_output_paths": True,
        "//conditions:default": False,
    }),
    param = "param_file",
)
