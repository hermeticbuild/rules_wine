        "fixture/fixture_aarch64.exe",
    ],
    visibility = ["//visibility:public"],
)

param_action(
    name = "param_file",
    binary = "fixture/fixture_x86_64.exe",
)

tools_action(
    name = "external_tools",
    testonly = True,
    additional_tools = True,
    binary = "fixture/fixture_x86_64.exe",
    extra = "runfiles_binary",
    extra_data = "@platforms//:LICENSE",
)

tools_action(
    name = "additional_tools",
    testonly = True,
    additional_tools = True,
    binary = "fixture/fixture_x86_64.exe",
    extra = "runfiles_binary",
)

default_tools_action(
    name = "default_group",
    binary = "fixture/fixture_x86_64.exe",
)

default_tools_action(
