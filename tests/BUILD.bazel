load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//tests:adapter_action.bzl", "adapter_action", "runfiles_action", "runfiles_adapter_action")
load("//tests:argv.bzl", "alias_data", "argv_record_test", "two_actions")
load("//tests:param_action.bzl", "param_action")
load("//tests:path_mapping.bzl", "mapping_action", "mapping_input", "mapping_payload", "mapping_variant")
load("//tests:tools_action.bzl", "default_tools_action", "native_tools_action", "tools_action")
load("//tests:verify_test.bzl", "runtime_contract_test")
load("//wine:windows_binary.bzl", "windows_binary")

# Compile generated C/headers with the development-only LLVM Windows SDK.
cc_library(
    name = "generated_rpc",
    testonly = True,
    srcs = [
        "//e2e/tools:rpc_c.c",
        "//e2e/tools:rpc_s.c",
    ],
    hdrs = ["//e2e/tools:tool_rpc.h"],
    # Current MinGW rpc.h omits ARM64 from its __RPC_WIN64__ definition.
    # Windows ARM64 RPC has 64-bit pointers, as required by WIDL's stubs.
    defines = select({
        "@platforms//cpu:aarch64": ["__RPC_WIN64__"],
        "//conditions:default": [],
    }),
)

cc_binary(
    name = "companion_build",
    testonly = True,
    srcs = ["fixture/companion.c"],
    linkopts = ["-Wl,--no-insert-timestamp"],
    linkshared = True,
)

cc_binary(
    name = "fixture_build",
    testonly = True,
    srcs = ["fixture/main.cc"],
    copts = [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    linkopts = ["-lshell32"],
)

cc_binary(
    name = "verify_build",
    testonly = True,
    srcs = ["verify/main.cc"],
    copts = [
        "-std=c++17",
        "-Wall",
        "-Wextra",
    ],
    deps = ["@nlohmann_json//:json"],
)

test_suite(
    name = "integration",
    tests = [
        "argv_test",
        "payload_layout_test",
        "runtime_contract_test",
    ],
)

cc_binary(
    name = "argv_verify",
    testonly = True,
    srcs = ["argv_verify.cc"],
    copts = [
        "-std=c++17",
        "-Wall",
        "-Wextra",
    ],
    deps = ["@nlohmann_json//:json"],
)

cc_binary(
    name = "runfiles_fixture",
    testonly = True,
    srcs = ["runfiles_fixture.cc"],
    copts = [
        "-std=c++17",
        "-Wall",
        "-Wextra",
        "-Werror",
    ],
    data = [
        "aliases",
        "@rules_cc//:LICENSE",
    ],
    deps = ["@rules_cc//cc/runfiles"],
)

runfiles_action(
    name = "standard_runfiles",
    testonly = True,
    tool = "runfiles_fixture",
)

windows_binary(
    name = "runfiles_binary",
    testonly = True,
    binary = "runfiles_fixture",
    target_platform = "@llvm//platforms:windows_x86_64",
)

runfiles_adapter_action(
    name = "adapter_runfiles",
    testonly = True,
    tool = "runfiles_binary",
)

default_tools_action(
    name = "generate",
    binary = "fixture/fixture_x86_64.exe",
)

native_tools_action(
    name = "generate_arm64",
    binary = "fixture/fixture_aarch64.exe",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

alias_data(
    name = "aliases",
    src = "data/alias-only.txt",
)

two_actions(
    name = "distinct_actions",
    binary = "fixture/fixture_x86_64.exe",
)

argv_record_test(
    name = "argv_test",
    records = {
        "adapter_runfiles": json.encode([
            "mapped external",
            "alias-only data",
        ]),
        "standard_runfiles": json.encode([
            "mapped external",
            "alias-only data",
        ]),
        "adapter_tool": json.encode([
            "--config",
            "payload-config.json",
            "--",
            "literal",
            "space value",
            "",
            "café",
            "$literal",
            "$(location data/a)",
            "opaque/option:one/two",
            "adapter-tool",
        ]),
    },
)

windows_binary(
    name = "binary",
    binary = "fixture/fixture_x86_64.exe",
    target_compatible_with = ["@platforms//cpu:x86_64"],
)

adapter_action(
    name = "adapter_tool",
    arguments = [
        "--config",
        "payload-config.json",
        "--",
        "literal",
        "space value",
        "",
        "café",
        "$literal",
        "$(location data/a)",
        "opaque/option:one/two",
    ],
