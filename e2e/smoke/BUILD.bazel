load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_wine//tests:runtime_consumer.bzl", "consumer")
load("@rules_wine//wine:windows_binary.bzl", "windows_binary")

config_setting(
    name = "mapped_paths",
    values = {"experimental_output_paths": "strip"},
)

config_setting(
    name = "windows_arm64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
)

[
    sh_test(
        name = cpu + "_test",
        size = "small",
        srcs = ["@rules_wine//tests:verify_runtime.sh"],
        args = [
            cpu,
            "$(rlocationpath @rules_wine//tests:fixture/fixture_" + cpu + ".exe)",
        ] + select({
            ":mapped_paths": ["strip"],
            "//conditions:default": ["off"],
        }) + select({
            "@platforms//os:windows": ["windows"],
            "//conditions:default": ["wine"],
        }) + select({
            "@platforms//cpu:aarch64": ["aarch64"],
            "//conditions:default": ["x86_64"],
        }) + ["$(rlocationpath :action_" + cpu + ")"] + select({
            "@platforms//os:windows": [],
            "//conditions:default": ["$(rlocationpath :adapter_" + cpu + ")"],
        }),
        data = [
            "action_" + cpu,
            "@rules_wine//tests:fixture/fixture_" + cpu + ".exe",
        ] + select({
            "@platforms//os:windows": [],
            "//conditions:default": ["adapter_" + cpu],
        }),
        target_compatible_with = ["@platforms//cpu:aarch64"] if cpu == "aarch64" else select({
            ":windows_arm64": ["@platforms//:incompatible"],
            "//conditions:default": [],
        }),
        deps = ["@rules_shell//shell/runfiles"],
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]

[
    windows_binary(
        name = "binary_" + cpu,
        binary = "@rules_wine//tests:fixture/fixture_" + cpu + ".exe",
        tags = ["manual"],
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]

[
    consumer(
        name = "action_" + cpu,
        binary = "@rules_wine//tests:fixture/fixture_" + cpu + ".exe",
        tags = ["manual"],
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]

[
    consumer(
        name = "adapter_" + cpu,
        adapter = "binary_" + cpu,
        binary = "@rules_wine//tests:fixture/fixture_" + cpu + ".exe",
        tags = ["manual"],
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]
