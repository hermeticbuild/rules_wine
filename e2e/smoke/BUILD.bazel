load("@rules_wine//wine:windows_binary.bzl", "windows_binary")
load(":consumer.bzl", "consumer")

[
    windows_binary(
        name = "binary_" + cpu,
        binary = "@rules_wine//tests:fixture/fixture_" + cpu + ".exe",
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]

[
    consumer(
        name = "action_" + cpu,
        binary = "@rules_wine//tests:fixture/fixture_" + cpu + ".exe",
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]

[
    consumer(
        name = "adapter_" + cpu,
        adapter = "binary_" + cpu,
        binary = "@rules_wine//tests:fixture/fixture_" + cpu + ".exe",
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]
