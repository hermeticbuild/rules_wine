load("@rules_wine//wine:toolchain.bzl", "windows_runner_toolchain")
load("@rules_wine//wine:windows_binary.bzl", "windows_binary")
load(":audit.bzl", "collision", "stub", "symlink_data")
load(":contracts.bzl", "contract_tests")
load(":execution.bzl", "grouped_actions")

package(default_visibility = ["//visibility:public"])

contract_tests()

platform(
    name = "audit_exec",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform(
    name = "audit_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "audit_windows",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

windows_runner_toolchain(
    name = "native_implementation",
    arch = "x86_64",
    backend = "native",
)

toolchain(
    name = "native_runner",
    exec_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":native_implementation",
    toolchain_type = "@rules_wine//wine:runner_toolchain_type",
)

stub(
    name = "launcher",
    data = ["launcher_data"],
    tags = ["manual"],
)

stub(
    name = "sidecar_launcher",
    data = ["launcher_data"],
    sidecar = True,
    tags = ["manual"],
)

windows_runner_toolchain(
    name = "sidecar_implementation",
    arch = "x86_64",
    backend = "wine",
    launcher = ":sidecar_launcher",
    loader = "loader",
    server = "server",
)

toolchain(
    name = "sidecar_runner",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":sidecar_implementation",
    toolchain_type = "@rules_wine//wine:runner_toolchain_type",
)

stub(name = "built_loader")

windows_runner_toolchain(
    name = "generated_implementation",
    arch = "x86_64",
    backend = "wine",
    launcher = ":launcher",
    loader = ":built_loader",
    server = "server",
)

toolchain(
    name = "generated_runner",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":generated_implementation",
    toolchain_type = "@rules_wine//wine:runner_toolchain_type",
)

windows_runner_toolchain(
    name = "implementation",
    arch = "x86_64",
    backend = "wine",
    launcher = ":launcher",
    loader = "loader",
    server = "server",
)

toolchain(
    name = "runner",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":implementation",
    toolchain_type = "@rules_wine//wine:runner_toolchain_type",
)

toolchain(
    name = "adapter",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":implementation",
    toolchain_type = "@rules_wine//wine:adapter_toolchain_type",
)

windows_runner_toolchain(
    name = "implementation_arm64",
    arch = "aarch64",
    backend = "wine",
    launcher = "launcher",
    loader = "loader",
    server = "server",
)

toolchain(
    name = "runner_arm64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    toolchain = "implementation_arm64",
    toolchain_type = "@rules_wine//wine:runner_toolchain_type",
)

grouped_actions(
    name = "grouped_actions",
    native = "payload_with_data",
    tags = ["manual"],
    wine = "payload_with_data",
)

toolchain(
    name = "adapter_arm64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    toolchain = "implementation_arm64",
    toolchain_type = "@rules_wine//wine:adapter_toolchain_type",
)

collision(
    name = "collision",
    binary = "payload.exe",
    tags = ["manual"],
)

collision(
    name = "fixed_action",
    binary = "payload.exe",
    exec_compatible_with = ["@platforms//cpu:x86_64"],
    tags = ["manual"],
)

symlink_data(
    name = "alias_data",
    src = "only_via_alias",
)

stub(
    name = "payload_with_data",
    data = ["alias_data"],
    tags = ["manual"],
)

windows_binary(
    name = "data_adapter",
    binary = select({"//conditions:default": "payload_with_data"}),
    tags = ["manual"],
)

windows_binary(
    name = "apparent_platform",
    binary = "payload.exe",
    tags = ["manual"],
    target_platform = "@rules_wine//platforms:windows_x86_64",
)

windows_binary(
    name = "wrong_platform",
    binary = "payload.exe",
    tags = ["manual"],
    target_platform = "audit_exec",
)

windows_binary(
    name = "wrong_cpu",
    binary = "payload.exe",
    tags = ["manual"],
    target_platform = "@rules_wine//platforms:windows_aarch64",
)
