load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_wine//wine:toolchain.bzl", "windows_runner_toolchain")
load("@rules_wine//wine:windows_binary.bzl", "windows_binary")
load("@rules_wine//wine:windows_import.bzl", "windows_import")
load(":audit.bzl", "collision", "stub", "symlink_data", "typed_action")
load(":execution.bzl", "grouped_actions")

package(default_visibility = ["//visibility:public"])

platform(
    name = "audit_exec",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "Arch": "amd64",
        "container-image": "docker://ubuntu:24.04",
    },
)

platform(
    name = "audit_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "Arch": "arm64",
        "container-image": "docker://ubuntu:24.04",
    },
)

platform(
    name = "audit_windows",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

windows_runner_toolchain(
    name = "native_implementation",
    backend = "native",
    supported_guest_cpus = ["@platforms//cpu:x86_64"],
)

toolchain(
    name = "native_runner",
    exec_compatible_with = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":native_implementation",
    toolchain_type = "@rules_wine//wine:runner_toolchain_type",
)

stub(
    name = "launcher",
    data = ["launcher_data"],
)

stub(
    name = "sidecar_launcher",
    data = ["launcher_data"],
    sidecar = True,
)

windows_runner_toolchain(
    name = "sidecar_implementation",
    backend = "wine",
    launcher = ":sidecar_launcher",
    loader = "loader",
    server = "server",
    supported_guest_cpus = ["@platforms//cpu:x86_64"],
)

toolchain(
    name = "sidecar_runner",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":sidecar_implementation",
    toolchain_type = "@rules_wine//wine:runner_toolchain_type",
)

stub(name = "built_loader")

windows_runner_toolchain(
    name = "generated_implementation",
    backend = "wine",
    launcher = ":launcher",
    loader = ":built_loader",
    server = "server",
    supported_guest_cpus = ["@platforms//cpu:x86_64"],
)

toolchain(
    name = "generated_runner",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":generated_implementation",
    toolchain_type = "@rules_wine//wine:runner_toolchain_type",
)

windows_runner_toolchain(
    name = "implementation",
    backend = "wine",
    launcher = ":launcher",
    loader = "loader",
    server = "server",
    supported_guest_cpus = ["@platforms//cpu:x86_64"],
)

toolchain(
    name = "runner",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":implementation",
    toolchain_type = "@rules_wine//wine:runner_toolchain_type",
)

toolchain(
    name = "adapter",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    toolchain = ":implementation",
    toolchain_type = "@rules_wine//wine:adapter_toolchain_type",
)

windows_runner_toolchain(
    name = "implementation_arm64",
    backend = "wine",
    launcher = "launcher",
    loader = "loader",
    server = "server",
    supported_guest_cpus = ["@platforms//cpu:aarch64"],
)

toolchain(
    name = "runner_arm64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    toolchain = "implementation_arm64",
    toolchain_type = "@rules_wine//wine:runner_toolchain_type",
)

grouped_actions(
    name = "grouped_actions",
    native = "payload_with_data",
    wine = "payload_with_data",
)

toolchain(
    name = "adapter_arm64",
    exec_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    target_compatible_with = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
    toolchain = "implementation_arm64",
    toolchain_type = "@rules_wine//wine:adapter_toolchain_type",
)

collision(
    name = "collision",
    binary = "payload.exe",
)

collision(
    name = "fixed_action",
    binary = "payload.exe",
    exec_compatible_with = ["@platforms//cpu:x86_64"],
)

symlink_data(
    name = "alias_data",
    src = "only_via_alias",
)

stub(
    name = "payload_with_data",
    data = ["alias_data"],
)

windows_binary(
    name = "data_adapter",
    binary = select({"//conditions:default": "payload_with_data"}),
)

windows_binary(
    name = "apparent_platform",
    binary = "payload.exe",
    target_platform = "@rules_wine//platforms:windows_x86_64",
)

windows_binary(
    name = "wrong_platform",
    binary = "payload.exe",
    target_platform = "audit_exec",
)

windows_binary(
    name = "wrong_cpu",
    binary = "payload.exe",
    target_platform = "@rules_wine//platforms:windows_aarch64",
)

windows_binary(
    name = "fixed_x86",
    binary = "payload.exe",
    target_compatible_with = ["@platforms//cpu:x86_64"],
)

windows_import(
    name = "x86_payload",
    data = ["companion_data"],
    executable = "payload_with_data",
    guest_cpu = "@platforms//cpu:x86_64",
)

windows_import(
    name = "arm_payload",
    executable = "payload.exe",
    guest_cpu = "@platforms//cpu:aarch64",
)

windows_binary(
    name = "declared_x86",
    binary = "x86_payload",
)

windows_binary(
    name = "declared_arm",
    binary = "arm_payload",
)

windows_binary(
    name = "imported_adapter",
    binary = "x86_payload",
)

cc_binary(
    name = "source",
    srcs = ["source.c"],
)

windows_binary(
    name = "source_adapter",
    binary = "source",
)

windows_binary(
    name = "explicit_source",
    binary = "source",
    target_platform = "@rules_wine//platforms:windows_x86_64",
)

filegroup(
    name = "selected_prebuilt",
    srcs = select({
        "@platforms//cpu:x86_64": ["@rules_wine//tests:fixture/fixture_x86_64.exe"],
        "@platforms//cpu:aarch64": ["@rules_wine//tests:fixture/fixture_aarch64.exe"],
    }),
)

windows_binary(
    name = "selected_adapter",
    binary = "selected_prebuilt",
)

filegroup(
    name = "fixed_prebuilt",
    srcs = ["@rules_wine//tests:fixture/fixture_x86_64.exe"],
)

windows_binary(
    name = "fixed_target_adapter",
    binary = "fixed_prebuilt",
)

typed_action(
    name = "native_declared_x86",
    tool = "x86_payload",
)

typed_action(
    name = "native_declared_arm",
    tool = "arm_payload",
)
