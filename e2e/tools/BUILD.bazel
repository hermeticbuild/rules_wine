load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@rules_wine//wine:tools_toolchain.bzl", "wine_tools_executable_toolchain")
load("@rules_wine//wine:wine_idl_files.bzl", "wine_idl_files")
load("@rules_wine//wine:wine_message_file.bzl", "wine_message_file")
load("@rules_wine//wine:wine_resource_file.bzl", "wine_resource_file")
load("fixture.bzl", "generated_inputs")

package(default_visibility = ["//visibility:public"])

constraint_setting(name = "worker")

constraint_value(
    name = "worker_a",
    constraint_setting = ":worker",
)

constraint_value(
    name = "worker_b",
    constraint_setting = ":worker",
)

platform(
    name = "selection_a",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":worker_a",
    ],
)

platform(
    name = "selection_b",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":worker_b",
    ],
)

platform(
    name = "selection_arm",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        ":worker_b",
    ],
)

# Analysis-only placeholders identify custom selections; these tools never run.
filegroup(
    name = "selection_files",
    srcs = [
        "messages.mc",
        "selection.tlb",
        "unicode.rc",
    ],
)

wine_tools_executable_toolchain(
    name = "selection_tools_a",
    include = "messages.mc",
    aarch64_typelib = "selection.tlb",
    files = "selection_files",
    widl = "messages.mc",
    wmc = "messages.mc",
    wrc = "messages.mc",
    x86_64_typelib = "selection.tlb",
)

wine_tools_executable_toolchain(
    name = "selection_tools_b",
    include = "unicode.rc",
    aarch64_typelib = "selection.tlb",
    files = "selection_files",
    widl = "unicode.rc",
    wmc = "unicode.rc",
    wrc = "unicode.rc",
    x86_64_typelib = "selection.tlb",
)

toolchain(
    name = "selection_registration_a",
    target_compatible_with = [":worker_a"],
    toolchain = "selection_tools_a",
    toolchain_type = "@rules_wine//wine:tools_executable_toolchain_type",
)

toolchain(
    name = "selection_registration_b",
    target_compatible_with = [":worker_b"],
    toolchain = "selection_tools_b",
    toolchain_type = "@rules_wine//wine:tools_executable_toolchain_type",
)

run_binary(
    name = "selection",
    outs = ["selection.out"],
    exec_compatible_with = [":worker_a"],
    tags = ["manual"],
    tool = "@rules_wine//wine:widl",
)

platform(
    name = "unsupported_cpu",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:riscv64",
    ],
)

generated_inputs(name = "generated")

wine_message_file(
    name = "messages",
    src = "messages.mc",
    out = "messages.rc",
)

wine_message_file(
    name = "message_res",
    src = "messages.mc",
    out = "messages.res",
    output_format = "res",
)

wine_message_file(
    name = "custom_messages",
    src = "messages.mc",
    out = "custom_messages.rc",
    header = "renamed_messages.h",
)

wine_resource_file(
    name = "inline_messages",
    src = "messages.rc",
    out = "inline_messages.res",
)

wine_message_file(
    name = "unicode_messages",
    src = "messages_utf16.mc",
    out = "unicode_messages.res",
    output_format = "res",
    unicode = True,
)

wine_resource_file(
    name = "resources",
    src = "resources.rc",
    out = "nested/resources.res",
    hdrs = ["generated/sub/resource_ids.h"],
    data = ["generated/assets/payload.txt"],
    defines = ["EXPECTED_DEFINE=37"],
    includes = [
        "",
        "generated",
    ],
)

wine_idl_files(
    name = "example",
    src = "generated/sub/example.idl",
    header = "example.h",
    proxy = "example_p.c",
)

wine_idl_files(
    name = "interfaces",
    src = "interfaces.idl",
    header = "nested/interfaces.h",
    iid = "interfaces_i.c",
    imports = [
        "generated/sub/example.idl",
        "generated/sub/resource_ids.h",
    ],
    includes = [
        ".",
        "generated",
    ],
    proxy = "interfaces_p.c",
    typelib = "interfaces.tlb",
)

wine_idl_files(
    name = "rpc",
    src = "rpc.idl",
    client = "rpc_c.c",
    header = "tool_rpc.h",
    server = "rpc_s.c",
)

filegroup(
    name = "all_outputs",
    srcs = [
        "custom_messages",
        "example",
        "inline_messages",
        "interfaces",
        "makevar_messages",
        "makevar_resources",
        "makevar_typelib",
        "message_res",
        "messages",
        "resources",
        "rpc",
        "run_messages",
        "run_quoted_resources",
        "run_resources",
        "run_typelib",
        "run_unicode_resources",
        "unicode_messages",
    ],
)

genrule(
    name = "makevar_messages",
    srcs = ["messages.mc"],
    outs = [
        "makevars/messages.h",
        "makevars/messages.rc",
    ],
    cmd = '"$(WINE_WMC)" -U -i -H "$(location makevars/messages.h)" -o "$(location makevars/messages.rc)" "$(location messages.mc)"',
    toolchains = ["@rules_wine//wine:tools_toolchain_type"],
)

run_binary(
    name = "run_messages",
    srcs = ["messages.mc"],
    outs = [
        "run/messages.h",
        "run/messages.rc",
    ],
    args = [
        "-U",
        "-i",
        "-H",
        "$(location run/messages.h)",
        "-o",
        "$(location run/messages.rc)",
        "$(location messages.mc)",
    ],
    tool = "@rules_wine//wine:wmc",
)

run_binary(
    name = "run_resources",
    srcs = ["run/messages.rc"],
    outs = ["run/messages.res"],
    args = [
        "-u",
        "-o",
        "$(location run/messages.res)",
        "$(location run/messages.rc)",
    ],
    tool = "@rules_wine//wine:wrc",
)

run_binary(
    name = "run_typelib",
    srcs = ["makevars.idl"],
    outs = ["run/interfaces.tlb"],
    args = [
        "-b",
        "x86_64-w64-mingw32",
        "-t",
        "-o",
        "$(location run/interfaces.tlb)",
        "$(location makevars.idl)",
    ],
    tool = "@rules_wine//wine:widl",
)

run_binary(
    name = "run_unicode_resources",
    srcs = ["unicode.rc"],
    outs = ["run/unicode.res"],
    args = [
        "-u",
        "-o",
        "$(location run/unicode.res)",
        "$(location unicode.rc)",
    ],
    tool = "@rules_wine//wine:wrc",
)

run_binary(
    name = "run_quoted_resources",
    srcs = ["unicode.rc"],
    outs = ["run/quoted.res"],
    args = [
        "'-DRESOURCE_TEXT=\"Wine tools: résumé\"'",
        "-u",
        "-o",
        "$(location run/quoted.res)",
        "$(location unicode.rc)",
    ],
    tool = "@rules_wine//wine:wrc",
)

genrule(
    name = "makevar_resources",
    srcs = ["makevars/messages.rc"],
    outs = ["makevars/messages.res"],
    cmd = '"$(WINE_WRC)" -u -o "$@" "$(location makevars/messages.rc)"',
    toolchains = ["@rules_wine//wine:tools_toolchain_type"],
)

genrule(
    name = "makevar_typelib",
    srcs = ["makevars.idl"],
    outs = ["makevars/interfaces.tlb"],
    cmd = '"$(WINE_WIDL)" -b x86_64-w64-mingw32 -t -o "$@" "$(location makevars.idl)"',
    toolchains = ["@rules_wine//wine:tools_toolchain_type"],
)

wine_resource_file(
    name = "missing_asset",
    src = "resources.rc",
    out = "missing_asset.res",
    hdrs = ["generated/sub/resource_ids.h"],
    defines = ["EXPECTED_DEFINE=37"],
    includes = ["generated"],
    tags = ["manual"],
)

wine_idl_files(
    name = "missing_import",
    src = "interfaces.idl",
    header = "missing_import.h",
    imports = ["generated/sub/resource_ids.h"],
    includes = ["generated"],
    tags = ["manual"],
)

wine_message_file(
    name = "bad_message",
    src = "bad.mc",
    out = "bad.rc",
    tags = ["manual"],
)

wine_idl_files(
    name = "qualified_import",
    src = "qualified_import.idl",
    header = "qualified_import.h",
    imports = ["generated/sub/example.idl"],
    includes = ["generated"],
    tags = ["manual"],
)

wine_resource_file(
    name = "absolute_include",
    src = "resources.rc",
    out = "absolute.res",
    includes = ["/usr/include"],
    tags = ["manual"],
)

wine_resource_file(
    name = "absolute_windows_include",
    src = "resources.rc",
    out = "absolute_windows.res",
    includes = ["C:/SDK"],
    tags = ["manual"],
)
