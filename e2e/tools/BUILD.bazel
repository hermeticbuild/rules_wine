load("@bazel_lib//lib:run_binary.bzl", "run_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("@rules_wine//wine:wine_idl_files.bzl", "wine_idl_files")
load("@rules_wine//wine:wine_message_file.bzl", "wine_message_file")
load("@rules_wine//wine:wine_resource_file.bzl", "wine_resource_file")
load("configured_outputs.bzl", "configured_outputs")
load("fixture.bzl", "generated_inputs")

package(default_visibility = ["//visibility:public"])

platform(
    name = "unsupported_cpu",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:riscv64",
    ],
)

generated_inputs(name = "generated")

wine_message_file(
    name = "messages",
    src = "messages.mc",
    out = "messages.rc",
    tags = ["manual"],
)

wine_message_file(
    name = "message_res",
    src = "messages.mc",
    out = "messages.res",
    output_format = "res",
    tags = ["manual"],
)

wine_message_file(
    name = "custom_messages",
    src = "messages.mc",
    out = "custom_messages.rc",
    header = "renamed_messages.h",
    tags = ["manual"],
)

wine_resource_file(
    name = "inline_messages",
    src = "messages.rc",
    out = "inline_messages.res",
    tags = ["manual"],
)

wine_message_file(
    name = "unicode_messages",
    src = "messages_utf16.mc",
    out = "unicode_messages.res",
    output_format = "res",
    tags = ["manual"],
    unicode = True,
)

wine_resource_file(
    name = "resources",
    src = "resources.rc",
    out = "nested/resources.res",
    hdrs = ["generated/sub/resource_ids.h"],
    data = ["generated/assets/payload.txt"],
    defines = ["EXPECTED_DEFINE=37"],
    includes = [
        "",
        "generated",
    ],
    tags = ["manual"],
)

wine_idl_files(
    name = "example",
    src = "generated/sub/example.idl",
    header = "example.h",
    proxy = "example_p.c",
    tags = ["manual"],
)

wine_idl_files(
    name = "interfaces",
    src = "interfaces.idl",
    header = "nested/interfaces.h",
    iid = "interfaces_i.c",
    imports = [
        "generated/sub/example.idl",
        "generated/sub/resource_ids.h",
    ],
    includes = [
        ".",
        "generated",
    ],
    proxy = "interfaces_p.c",
    tags = ["manual"],
    typelib = "interfaces.tlb",
)

wine_idl_files(
    name = "rpc",
    src = "@rules_wine//tests:fixture/rpc.idl",
    client = "rpc_c.c",
    header = "tool_rpc.h",
    server = "rpc_s.c",
    tags = ["manual"],
)

filegroup(
    name = "all_outputs",
    srcs = [
        "custom_messages",
        "example",
        "generated",
        "inline_messages",
        "interfaces",
        "makevar_messages",
        "makevar_resources",
        "makevar_typelib",
        "message_res",
        "messages",
        "resources",
        "rpc",
        "run_messages",
        "run_quoted_resources",
        "run_resources",
        "run_typelib",
        "run_unicode_resources",
        "unicode_messages",
    ],
    tags = ["manual"],
)

config_setting(
    name = "mapped_paths",
    values = {"experimental_output_paths": "strip"},
)

[
    configured_outputs(
        name = cpu + "_outputs",
        testonly = True,
        src = "all_outputs",
        platform = "@rules_wine//platforms:windows_" + cpu,
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]

[
    sh_test(
        name = cpu + "_test",
        srcs = ["verify.sh"],
        args = ["$(rlocationpath " + cpu + "_outputs/messages.h)"] + select({
            ":mapped_paths": ["strip"],
            "//conditions:default": ["off"],
        }),
        data = [
            cpu + "_outputs",
            cpu + "_outputs/messages.h",
        ],
        deps = ["@rules_shell//shell/runfiles"],
    )
    for cpu in [
        "x86_64",
        "aarch64",
    ]
]

sh_test(
    name = "distinct_abis_test",
    srcs = ["verify_abis.sh"],
    args = [
        "$(rlocationpath x86_64_outputs/example_p.c)",
        "$(rlocationpath aarch64_outputs/example_p.c)",
        "$(rlocationpath x86_64_outputs/rpc_c.c)",
        "$(rlocationpath aarch64_outputs/rpc_c.c)",
    ],
    data = [
        "aarch64_outputs/example_p.c",
        "aarch64_outputs/rpc_c.c",
        "x86_64_outputs/example_p.c",
        "x86_64_outputs/rpc_c.c",
    ],
    deps = ["@rules_shell//shell/runfiles"],
)

genrule(
    name = "makevar_messages",
    srcs = ["messages.mc"],
    outs = [
        "makevars/messages.h",
        "makevars/messages.rc",
    ],
    cmd = '"$(WINE_WMC)" -U -i -H "$(location makevars/messages.h)" -o "$(location makevars/messages.rc)" "$(location messages.mc)"',
    tags = ["manual"],
    toolchains = ["@rules_wine//wine:tools_toolchain_type"],
)

run_binary(
    name = "run_messages",
    srcs = ["messages.mc"],
    outs = [
        "run/messages.h",
        "run/messages.rc",
    ],
    args = [
        "-U",
        "-i",
        "-H",
        "$(location run/messages.h)",
        "-o",
        "$(location run/messages.rc)",
        "$(location messages.mc)",
    ],
    tags = ["manual"],
    tool = "@rules_wine//wine:wmc",
)

run_binary(
    name = "run_resources",
    srcs = ["run/messages.rc"],
    outs = ["run/messages.res"],
    args = [
        "-u",
        "-o",
        "$(location run/messages.res)",
        "$(location run/messages.rc)",
    ],
    tags = ["manual"],
    tool = "@rules_wine//wine:wrc",
)

run_binary(
    name = "run_typelib",
    srcs = ["makevars.idl"],
    outs = ["run/interfaces.tlb"],
    args = [
        "-b",
        "x86_64-w64-mingw32",
        "-t",
        "-o",
        "$(location run/interfaces.tlb)",
        "$(location makevars.idl)",
    ],
    tags = ["manual"],
    tool = "@rules_wine//wine:widl",
)

run_binary(
    name = "run_unicode_resources",
    srcs = ["unicode.rc"],
    outs = ["run/unicode.res"],
    args = [
        "-u",
        "-o",
        "$(location run/unicode.res)",
        "$(location unicode.rc)",
    ],
    tags = ["manual"],
    tool = "@rules_wine//wine:wrc",
)

run_binary(
    name = "run_quoted_resources",
    srcs = ["unicode.rc"],
    outs = ["run/quoted.res"],
    args = [
        "'-DRESOURCE_TEXT=\"Wine tools: quoted\"'",
        "-u",
        "-o",
        "$(location run/quoted.res)",
        "$(location unicode.rc)",
    ],
    tags = ["manual"],
    tool = "@rules_wine//wine:wrc",
)

genrule(
    name = "makevar_resources",
    srcs = ["makevars/messages.rc"],
    outs = ["makevars/messages.res"],
    cmd = '"$(WINE_WRC)" -u -o "$@" "$(location makevars/messages.rc)"',
    tags = ["manual"],
    toolchains = ["@rules_wine//wine:tools_toolchain_type"],
)

genrule(
    name = "makevar_typelib",
    srcs = ["makevars.idl"],
    outs = ["makevars/interfaces.tlb"],
    cmd = '"$(WINE_WIDL)" -b x86_64-w64-mingw32 -t -o "$@" "$(location makevars.idl)"',
    tags = ["manual"],
    toolchains = ["@rules_wine//wine:tools_toolchain_type"],
)

wine_resource_file(
    name = "missing_asset",
    src = "resources.rc",
    out = "missing_asset.res",
    hdrs = ["generated/sub/resource_ids.h"],
    defines = ["EXPECTED_DEFINE=37"],
    includes = ["generated"],
    tags = ["manual"],
)

wine_idl_files(
    name = "missing_import",
    src = "interfaces.idl",
    header = "missing_import.h",
    imports = ["generated/sub/resource_ids.h"],
    includes = ["generated"],
    tags = ["manual"],
)

wine_message_file(
    name = "bad_message",
    src = "bad.mc",
    out = "bad.rc",
    tags = ["manual"],
)

wine_idl_files(
    name = "qualified_import",
    src = "qualified_import.idl",
    header = "qualified_import.h",
    imports = ["generated/sub/example.idl"],
    includes = ["generated"],
    tags = ["manual"],
)

wine_resource_file(
    name = "absolute_include",
    src = "resources.rc",
    out = "absolute.res",
    includes = ["/usr/include"],
    tags = ["manual"],
)

wine_resource_file(
    name = "absolute_windows_include",
    src = "resources.rc",
    out = "absolute_windows.res",
    includes = ["C:/SDK"],
    tags = ["manual"],
)

exports_files([
    "messages.mc",
    "unicode.rc",
    "selection.tlb",
])
