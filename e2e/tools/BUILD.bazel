load("@rules_wine//wine:wine_idl_compile.bzl", "wine_idl_compile")
load("@rules_wine//wine:wine_message_compile.bzl", "wine_message_compile")
load("@rules_wine//wine:wine_resource_compile.bzl", "wine_resource_compile")
load("fixture.bzl", "generated_inputs")

package(default_visibility = ["//visibility:public"])

platform(
    name = "unsupported_cpu",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:riscv64",
    ],
)

generated_inputs(name = "generated")

wine_message_compile(
    name = "messages",
    src = "messages.mc",
    out = "messages.rc",
)

wine_message_compile(
    name = "message_res",
    src = "messages.mc",
    out = "messages.res",
    output_format = "res",
)

wine_message_compile(
    name = "custom_messages",
    src = "messages.mc",
    out = "custom_messages.rc",
    header = "renamed_messages.h",
)

wine_resource_compile(
    name = "inline_messages",
    src = "messages.rc",
    out = "inline_messages.res",
)

wine_message_compile(
    name = "unicode_messages",
    src = "messages_utf16.mc",
    out = "unicode_messages.res",
    output_format = "res",
    unicode = True,
)

wine_resource_compile(
    name = "resources",
    src = "resources.rc",
    out = "nested/resources.res",
    hdrs = ["generated/sub/resource_ids.h"],
    data = ["generated/assets/payload.txt"],
    defines = ["EXPECTED_DEFINE=37"],
    includes = [
        "",
        "generated",
    ],
)

wine_idl_compile(
    name = "example",
    src = "generated/sub/example.idl",
    header = "example.h",
    proxy = "example_p.c",
)

wine_idl_compile(
    name = "interfaces",
    src = "interfaces.idl",
    header = "nested/interfaces.h",
    iid = "interfaces_i.c",
    imports = [
        "generated/sub/example.idl",
        "generated/sub/resource_ids.h",
    ],
    includes = [
        ".",
        "generated",
    ],
    proxy = "interfaces_p.c",
    typelib = "interfaces.tlb",
)

wine_idl_compile(
    name = "rpc",
    src = "rpc.idl",
    client = "rpc_c.c",
    header = "tool_rpc.h",
    server = "rpc_s.c",
)

filegroup(
    name = "all_outputs",
    srcs = [
        "custom_messages",
        "example",
        "inline_messages",
        "interfaces",
        "makevar_messages",
        "makevar_resources",
        "makevar_typelib",
        "message_res",
        "messages",
        "resources",
        "rpc",
        "unicode_messages",
    ],
)

genrule(
    name = "makevar_messages",
    srcs = ["messages.mc"],
    outs = [
        "makevars/messages.h",
        "makevars/messages.rc",
    ],
    cmd = '"$(WINE_WMC)" -U -i -H "$(location makevars/messages.h)" -o "$(location makevars/messages.rc)" "$(location messages.mc)"',
    toolchains = ["@rules_wine//wine:tools_toolchain_type"],
)

genrule(
    name = "makevar_resources",
    srcs = ["makevars/messages.rc"],
    outs = ["makevars/messages.res"],
    cmd = '"$(WINE_WRC)" -u -o "$@" "$(location makevars/messages.rc)"',
    toolchains = ["@rules_wine//wine:tools_toolchain_type"],
)

genrule(
    name = "makevar_typelib",
    srcs = ["makevars.idl"],
    outs = ["makevars/interfaces.tlb"],
    cmd = '"$(WINE_WIDL)" -b x86_64-w64-mingw32 -t -o "$@" "$(location makevars.idl)"',
    toolchains = ["@rules_wine//wine:tools_toolchain_type"],
)

wine_resource_compile(
    name = "missing_asset",
    src = "resources.rc",
    out = "missing_asset.res",
    hdrs = ["generated/sub/resource_ids.h"],
    defines = ["EXPECTED_DEFINE=37"],
    includes = ["generated"],
    tags = ["manual"],
)

wine_idl_compile(
    name = "missing_import",
    src = "interfaces.idl",
    header = "missing_import.h",
    imports = ["generated/sub/resource_ids.h"],
    includes = ["generated"],
    tags = ["manual"],
)

wine_message_compile(
    name = "bad_message",
    src = "bad.mc",
    out = "bad.rc",
    tags = ["manual"],
)

wine_idl_compile(
    name = "qualified_import",
    src = "qualified_import.idl",
    header = "qualified_import.h",
    imports = ["generated/sub/example.idl"],
    includes = ["generated"],
    tags = ["manual"],
)

wine_resource_compile(
    name = "absolute_include",
    src = "resources.rc",
    out = "absolute.res",
    includes = ["/usr/include"],
    tags = ["manual"],
)

wine_resource_compile(
    name = "absolute_windows_include",
    src = "resources.rc",
    out = "absolute_windows.res",
    includes = ["C:/SDK"],
    tags = ["manual"],
)
