module(
    name = "rules_wine",
    version = "0.1.0",
    bazel_compatibility = [">=8.5.0"],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "llvm", version = "0.7.6")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "hermetic_launcher", version = "0.0.16")

register_toolchains(
    "@llvm//toolchain:all",
)

wine = use_extension("//wine/extension:wine.bzl", "wine", dev_dependency = True)
use_repo(wine, "wine_prebuilt_linux_aarch64", "wine_toolchains")

register_toolchains(
    "@wine_toolchains//:all",
    dev_dependency = True,
)
